# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env est ignoré par git : ne jamais y commiter de vrais secrets.

# URLs (optionnelles, valeurs par défaut dans config/env.ts)
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# Compte client (obligatoire pour les tests customer et le test de login)
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Compte administrateur (obligatoire pour les tests admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
